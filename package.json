{
  "name": "avielle-mvp",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "prisma generate && next build",
    "start": "node server.cjs",
    "db:deploy": "prisma migrate deploy",
    "db:generate": "prisma generate",
    "admin:create": "node --env-file-if-exists=.env --import tsx scripts/create-admin.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.tests.json",
    "test": "tsx --test tests/*.test.ts",
    "check:launch": "node --env-file-if-exists=.env --import tsx scripts/check-launch.ts",
    "db:local": "node scripts/local-db.mjs",
    "test:postgres": "node scripts/test-postgres.mjs",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.900.0",
    "@prisma/client": "6.12.0",
    "@prisma/extension-accelerate": "^2.0.2",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "lucide-react": "^0.468.0",
    "next": "15.5.26",
    "prisma": "6.12.0",
    "react": "19.1.4",
    "react-dom": "19.1.4",
    "sharp": "^0.35.4",
    "stripe": "^20.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@electric-sql/pglite-socket": "^0.2.11",
    "@playwright/test": "^1.63.0",
    "embedded-postgres": "^16.14.0-beta.17",
    "pg": "^8.16.0",
    "prettier": "3.6.2"
  },
  "overrides": {
    "postcss": "^8.5.23"
  },
  "main": "server.cjs"
}
