# GoDaddy Node.js Hosting: prisma:// Accelerate URL (HTTPS transport).
# GoDaddy VPS/local: postgresql:// URL. Always use a NEW empty MVP database.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/avielle"
# Direct URL is for explicit migrations run from your workstation/CI, not the build.
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/avielle"
APP_URL="http://localhost:3000"
CURRENCY="gbp"
COMMISSION_BPS="1800"
RENTER_FEE_BPS="800"
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_CONNECT_COUNTRY="GB"
RESEND_API_KEY=""
EMAIL_FROM=""
S3_BUCKET=""
S3_REGION="auto"
S3_ENDPOINT=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_FORCE_PATH_STYLE="false"
# local is supported ONLY in development. Production requires private S3 storage.
STORAGE_DRIVER="s3"
# Optional footer/contact/legal links must be finalized before accepting customers.
NEXT_PUBLIC_SUPPORT_EMAIL=""
NEXT_PUBLIC_TERMS_URL=""
NEXT_PUBLIC_PRIVACY_URL=""
# One-time admin bootstrap only: set ADMIN_EMAIL, ADMIN_NAME and ADMIN_PASSWORD
# in a secure shell, run npm run admin:create, then remove ADMIN_PASSWORD.
# Production runtime uses NODE_ENV=production and the host-provided PORT.
